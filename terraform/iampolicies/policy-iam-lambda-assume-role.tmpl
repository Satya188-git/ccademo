{
	"Version": "2012-10-17",
	"Statement": [
		{   "Sid": "BasicGluePermissions",
			"Effect": "Allow",
			"Action": [
				"glue:GetCrawler",
				"glue:GetTables",
				"glue:StartCrawler",
				"glue:UpdateTable",
				"glue:GetTable"
			],
			"Resource": [
				"arn:aws:glue:${region}:${account}:database/*",
				"arn:aws:glue:${region}:${account}:crawler/*"
			]
		},
		{   
            "Sid": "BasicS3Permissions",
			"Effect": "Allow",
			"Action": [
				"s3:ReplicateObject",
				"s3:PutObject",
				"s3:GetObject",
				"s3:GetObjectAttributes",
				"s3:ListBucket",
				"s3:DeleteObject",
				"s3:GetBucketLocation",
				"s3:ListMultipartUploadParts"
			],
			"Resource": [
				"arn:aws:s3:::${company_code}-${application_code}-${environment_code}-${region_code}-s3-${application_use}"
			]
		},
		{   
            "Sid": "BasicAthenaPermissions",
			"Effect": "Allow",
			"Action": [
				"athena:"*
			],
			"Resource": [
				"*"
			]
		},
		{
			"Sid": "BasicSecretPermissions",
			"Effect": "Allow",
			"Action": [
				"secretsmanager:ListSecrets",
				"secretsmanager:DescribeSecret",
				"secretsmanager:GetSecretValue",
				"secretsmanager:ListSecretVersionIds"
			],
			"Resource": [
				"*"
			]
		}
	]
}